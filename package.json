{
  "name": "complejo-deportivo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "backend\\venv\\Scripts\\python.exe backend/manage.py runserver",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:php": "concurrently -n backend-php,frontend -c blue,green \"npm:dev:backend:php\" \"npm:dev:frontend\"",
    "dev:backend:php": "php -S localhost:8000 -t backend-php/public backend-php/public/router.php"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
